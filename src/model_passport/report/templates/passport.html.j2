<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Model Passport: {{ p.identity.model_name }} {{ p.identity.version }}</title>
<style>
  :root {
    --fg: #111827; --muted: #6b7280; --line: #e5e7eb; --bg: #f9fafb; --card: #ffffff;
    --pass: #15803d; --pass-bg: #dcfce7; --warn: #b45309; --warn-bg: #fef3c7;
    --fail: #b91c1c; --fail-bg: #fee2e2; --none: #374151; --none-bg: #e5e7eb;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 14px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
         color: var(--fg); background: var(--bg); }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  h1 { margin: 0; font-size: 26px; } h2 { font-size: 18px; margin: 0 0 12px; }
  h3 { font-size: 14px; margin: 16px 0 8px; color: var(--muted); text-transform: uppercase;
       letter-spacing: .04em; }
  .sub { color: var(--muted); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
          padding: 20px; margin-top: 20px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 600;
           font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .big { font-size: 18px; padding: 8px 18px; }
  .pass { color: var(--pass); background: var(--pass-bg); }
  .warn { color: var(--warn); background: var(--warn-bg); }
  .fail { color: var(--fail); background: var(--fail-bg); }
  .none, .info, .low { color: var(--none); background: var(--none-bg); }
  .medium { color: var(--warn); background: var(--warn-bg); }
  .high, .critical { color: var(--fail); background: var(--fail-bg); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .stat { border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
  .stat .v { font-size: 22px; font-weight: 600; } .stat .k { color: var(--muted); font-size: 12px; }
  ul.points { margin: 8px 0 0; padding-left: 20px; } ul.points li { margin: 4px 0; }
  .concerns li { color: var(--fail); }
  .flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; }
  .stage { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; min-width: 200px;
           flex: 1; background: #fcfcfd; }
  .stage b { display: block; margin-bottom: 4px; } .arrow { align-self: center; color: var(--muted); }
  details summary { cursor: pointer; color: var(--muted); }
  footer { margin-top: 32px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<main>
{% set v = summary.verdict.value if summary.verdict else "none" %}
<header>
  <div>
    <div class="sub">Model Passport</div>
    <h1>{{ p.identity.model_name }} <span class="sub">v{{ p.identity.version }}</span></h1>
    <div class="sub mono">{{ p.identity.passport_id }} · built {{ p.identity.created_at.strftime("%Y-%m-%d %H:%M UTC") }}</div>
  </div>
  <span class="badge big {{ v }}">{{ v if v != "none" else "no policy" }}</span>
</header>

<section class="card" id="summary">
  <h2>{{ summary.headline }}</h2>
  {% if p.declared.intended_use %}<p><b>Intended use:</b> {{ p.declared.intended_use }}</p>{% endif %}
  {% if summary.concerns %}
  <h3>Concerns</h3>
  <ul class="points concerns">{% for c in summary.concerns %}<li>{{ c }}</li>{% endfor %}</ul>
  {% endif %}
  {% if summary.points %}
  <h3>Checks</h3>
  <ul class="points">{% for pt in summary.points %}<li>{{ pt }}</li>{% endfor %}</ul>
  {% endif %}
  {% if p.declared.out_of_scope_uses or p.declared.known_limitations or p.declared.ethical_risks %}
  <div class="grid" style="margin-top:12px">
    {% for title, items in [("Out of scope", p.declared.out_of_scope_uses), ("Known limitations", p.declared.known_limitations), ("Ethical risks", p.declared.ethical_risks)] if items %}
    <div><h3>{{ title }}</h3><ul class="points">{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul></div>
    {% endfor %}
  </div>
  {% endif %}
  {% if p.declared.owner or p.declared.contact %}
  <p class="sub">Owner: {{ p.declared.owner or "n/a" }}{% if p.declared.contact %} · {{ p.declared.contact }}{% endif %}</p>
  {% endif %}
</section>

{% if verification %}
<section class="card" id="verification">
  <h2>Verification <span class="badge {{ 'pass' if verification.ok else 'fail' }}">{{ "verified" if verification.ok else "failed" }}</span></h2>
  <div class="grid">
    <div class="stat"><div class="k">Signature</div><div class="v">{{ "valid" if verification.signature_ok else "INVALID" }}</div></div>
    <div class="stat"><div class="k">Merkle root</div><div class="v">{{ "matches" if verification.merkle_ok else "MISMATCH" }}</div></div>
    <div class="stat"><div class="k">Signing key</div><div class="v">{{ "matches" if verification.fingerprint_ok else "MISMATCH" }}</div></div>
    <div class="stat"><div class="k">Artifacts unchanged</div><div class="v">{% if verification.artifacts %}{{ verification.artifacts|length - verification.changed|length }}/{{ verification.artifacts|length }}{% else %}not checked here{% endif %}</div></div>
    <div class="stat"><div class="k">Lifecycle events</div><div class="v">{{ "chain intact" if not verification.event_errors else "BROKEN" }}</div></div>
  </div>
  {% for c in verification.changed %}<p class="fail mono">CHANGED {{ c.path }} ({{ c.status.value }})</p>{% endfor %}
  {% for e in verification.event_errors %}<p class="fail mono">{{ e }}</p>{% endfor %}
</section>
{% endif %}

{% if p.policy %}
<section class="card" id="policy">
  <h2>Policy gate</h2>
  <table>
    <tr><th>Rule</th><th>Result</th><th>Observed</th><th>Threshold</th><th>Detail</th></tr>
    {% for r in p.policy.rules %}
    <tr><td class="mono">{{ r.name }}</td><td><span class="badge {{ r.result.value }}">{{ r.result.value }}</span></td>
        <td>{{ r.observed if r.observed is not none else "–" }}</td><td class="mono">{{ r.threshold|threshold }}</td><td>{{ r.message }}</td></tr>
    {% endfor %}
  </table>
  <p class="sub mono">policy sha256 {{ p.policy.policy_sha256|short(16) }}</p>
</section>
{% endif %}

<section class="card" id="model">
  <h2>Model</h2>
  {% if p.model %}
  <div class="grid">
    <div class="stat"><div class="k">Algorithm</div><div class="v">{{ p.model.algorithm or "–" }}</div></div>
    <div class="stat"><div class="k">Framework</div><div class="v">{{ p.model.framework or "–" }}</div></div>
    <div class="stat"><div class="k">Task</div><div class="v">{{ p.model.task_type or "–" }}</div></div>
  </div>
  {% if p.model.hyperparameters %}<h3>Hyperparameters</h3><p class="mono">{% for k, val in p.model.hyperparameters.items() %}{{ k }}={{ val }}{{ ", " if not loop.last }}{% endfor %}</p>{% endif %}
  <p class="sub mono">{{ p.model.artifact_uri }} · sha256 {{ p.model.artifact_sha256|short(16) }}</p>
  {% endif %}
  {% if p.metrics %}
  <h3>Metrics</h3>
  {% set names = p.metrics.values()|map("list")|sum(start=[])|unique|list %}
  <table><tr><th>Split</th>{% for n in names %}<th>{{ n }}</th>{% endfor %}</tr>
  {% for split, values in p.metrics.items() %}<tr><td>{{ split }}</td>{% for n in names %}<td>{{ values[n]|num if n in values else "–" }}</td>{% endfor %}</tr>{% endfor %}
  </table>
  {% endif %}
</section>

{% set pr = p.privacy_report %}
{% if pr %}
<section class="card" id="privacy">
  <h2>Privacy</h2>
  {% if pr.leakage %}
  <h3>Membership inference (loss-threshold attack)</h3>
  <div class="grid">
    <div class="stat"><div class="k">Attack AUC (0.5 = no leakage)</div><div class="v">{{ "%.3f"|format(pr.leakage.mia_auc) }}</div></div>
    <div class="stat"><div class="k">TPR at {{ pr.leakage.low_fpr|pct }} FPR</div><div class="v">{{ pr.leakage.tpr_at_low_fpr|pct }}</div></div>
    <div class="stat"><div class="k">Generalization gap ({{ pr.leakage.gap_metric }})</div><div class="v">{{ "%.3f"|format(pr.leakage.generalization_gap or 0) }}</div></div>
    <div class="stat"><div class="k">Members / non-members</div><div class="v">{{ pr.leakage.members }} / {{ pr.leakage.nonmembers }}</div></div>
  </div>
  {% endif %}
  {% if pr.reidentification %}
  <h3>Reidentification risk</h3>
  <table><tr><th>Dataset</th><th>Quasi-identifiers</th><th>k-anonymity</th><th>l-diversity</th><th>Unique records</th><th>Risky combinations</th></tr>
  {% for r in pr.reidentification %}
  <tr><td>{{ r.dataset }}</td><td class="mono">{{ r.quasi_identifiers|join(", ") or "–" }}</td><td>{{ r.k_anonymity if r.k_anonymity is not none else "–" }}</td>
      <td>{{ r.l_diversity if r.l_diversity is not none else "–" }}</td><td>{{ r.unique_fraction|pct }}</td>
      <td class="mono">{% for c in r.risky_combinations[:4] %}{{ c.columns|join("+") }} ({{ c.unique_fraction|pct }}){{ "; " if not loop.last }}{% endfor %}</td></tr>
  {% endfor %}</table>
  {% endif %}
  <h3>Data scan findings ({{ pr.datasets_scanned|join(", ") or "none scanned" }})</h3>
  {% set pii = pr.data_findings|selectattr("scanner", "equalto", "pii")|list %}
  {% if pii %}
  <table><tr><th>Severity</th><th>Entity</th><th>Location</th><th>Rows</th><th>Hit rate</th><th>Masked examples</th></tr>
  {% for f in pii %}<tr><td><span class="badge {{ f.severity.value }}">{{ f.severity.value }}</span></td><td class="mono">{{ f.category }}</td><td class="mono">{{ f.location }}</td>
      <td>{{ f.count }}</td><td>{{ f.details.hit_rate|pct if f.details.hit_rate is not none else "name only" }}</td><td class="mono">{{ f.masked_examples|join(", ") }}</td></tr>{% endfor %}
  </table>
  {% else %}<p>No PII detected.</p>{% endif %}
</section>
{% endif %}

{% set sr = p.security_report %}
{% if sr %}
<section class="card" id="security">
  <h2>Security</h2>
  <div class="grid">
    <div class="stat"><div class="k">Files scanned for secrets</div><div class="v">{{ sr.files_scanned_for_secrets if sr.files_scanned_for_secrets is not none else "–" }}</div></div>
    <div class="stat"><div class="k">Confirmed secrets</div><div class="v">{{ sr.secret_findings|select("serious")|list|length }}</div></div>
    <div class="stat"><div class="k">Artifacts scanned</div><div class="v">{{ sr.artifacts_scanned|length }}</div></div>
    <div class="stat"><div class="k">Dependency CVEs ({{ sr.dependency_audit.value }})</div><div class="v">{{ sr.dependency_vulnerabilities|length }}</div></div>
  </div>
  {% set all = sr.secret_findings + sr.artifact_findings + sr.dependency_vulnerabilities %}
  {% if all %}
  <table style="margin-top:12px"><tr><th>Severity</th><th>Check</th><th>Category</th><th>Location</th><th>Detail</th></tr>
  {% for f in all %}<tr><td><span class="badge {{ f.severity.value }}">{{ f.severity.value }}</span></td><td>{{ f.scanner }}</td><td class="mono">{{ f.category }}</td><td class="mono">{{ f.location }}</td><td>{{ f.message }}</td></tr>{% endfor %}
  </table>
  {% endif %}
  {% if sr.dependency_audit_message %}<p class="sub">{{ sr.dependency_audit_message }}</p>{% endif %}
</section>
{% endif %}

{% if p.pipeline %}
<section class="card" id="pipeline">
  <h2>Pipeline</h2>
  <div class="flow">
  {% for s in p.pipeline %}
    <div class="stage"><b>{{ loop.index }}. {{ s.name }}</b>
      <div class="mono">{{ s.script_path }} @ {{ s.git_commit|short(8) or "no git" }}{{ " (dirty)" if s.git_dirty }}</div>
      {% if s.parameters %}<div class="mono sub">{% for k, val in s.parameters.items() %}{{ k }}={{ val }}{{ ", " if not loop.last }}{% endfor %}</div>{% endif %}
      <div class="sub">in: <span class="mono">{{ s.inputs|map(attribute="path")|join(", ") or "–" }}</span></div>
      <div class="sub">out: <span class="mono">{{ s.outputs|map(attribute="path")|join(", ") or "–" }}</span></div>
    </div>
    {% if not loop.last %}<div class="arrow">→</div>{% endif %}
  {% endfor %}
  </div>
</section>
{% endif %}

{% if p.datasets %}
<section class="card" id="datasets">
  <h2>Datasets</h2>
  <table><tr><th>Name</th><th>Role</th><th>Rows</th><th>Columns</th><th>Source</th><th>License</th><th>SHA256</th></tr>
  {% for d in p.datasets %}<tr><td>{{ d.name }}</td><td>{{ d.split_role.value }}</td><td>{{ "{:,}".format(d.row_count) if d.row_count is not none else "–" }}</td>
      <td>{{ d.column_schema|length if d.column_schema else "–" }}</td><td>{{ d.source or "–" }}</td><td>{{ d.license or "–" }}</td><td class="mono">{{ d.sha256|short(12) }}</td></tr>{% endfor %}
  </table>
</section>
{% endif %}

{% if p.revision %}
{% set rv = p.revision %}
<section class="card" id="revision">
  <h2>Changes since v{{ rv.previous_version }}</h2>
  {% if rv.reason %}<p>{{ rv.reason }}</p>{% endif %}
  <table><tr><th>Dataset</th><th>Status</th><th>Rows before</th><th>Rows now</th></tr>
  {% for c in rv.dataset_changes %}<tr><td>{{ c.name }}</td><td>{{ c.status.value }}</td><td>{{ c.previous_rows if c.previous_rows is not none else "–" }}</td><td>{{ c.current_rows if c.current_rows is not none else "–" }}</td></tr>{% endfor %}
  </table>
  {% if rv.metric_deltas %}<h3>Metric changes</h3><p class="mono">{% for split, vals in rv.metric_deltas.items() %}{% for k, d in vals.items() %}{{ split }}.{{ k }} {{ "%+.4f"|format(d) }}{{ "; " }}{% endfor %}{% endfor %}</p>{% endif %}
  <p class="sub">{{ rv.changed_artifacts|length }} changed, {{ rv.added_artifacts|length }} added, {{ rv.removed_artifacts|length }} removed artifacts · supersedes <span class="mono">{{ rv.previous_passport_id }}</span></p>
</section>
{% endif %}

{% if p.events %}
<section class="card" id="events">
  <h2>Lifecycle events</h2>
  <table><tr><th>When</th><th>Type</th><th>Summary</th></tr>
  {% for e in p.events %}<tr><td class="mono">{{ e.timestamp.strftime("%Y-%m-%d %H:%M") }}</td><td>{{ e.event_type }}</td>
      <td>{% if e.event_type == "drift_check" %}{{ "drift detected in " ~ (e.payload.drifted_features|join(", ")) if e.payload.drift_detected else "no drift" }} ({{ e.payload.rows }} rows){% else %}{{ e.payload.get("summary", "") }}{% endif %}</td></tr>{% endfor %}
  </table>
</section>
{% endif %}

<section class="card" id="identity">
  <h2>Identity</h2>
  <table>
    <tr><th>Merkle root</th><td class="mono">{{ p.identity.merkle_root }}</td></tr>
    <tr><th>Signing key</th><td class="mono">{{ p.identity.public_key_fingerprint }}</td></tr>
    <tr><th>Signature</th><td class="mono">{{ p.identity.signature|short(32) }}</td></tr>
    {% if p.lineage_links %}<tr><th>Upstream models</th><td class="mono">{{ p.lineage_links|join(", ") }}</td></tr>{% endif %}
  </table>
  <details style="margin-top:12px"><summary>{{ p.artifacts|length }} hashed artifacts</summary>
    <table>{% for a in p.artifacts %}<tr><td class="mono">{{ a.path }}</td><td>{{ a.kind.value }}</td><td>{{ "{:,}".format(a.size_bytes) }} B</td><td class="mono">{{ a.sha256|short(16) }}</td></tr>{% endfor %}</table>
  </details>
  {% if p.environment %}
  <details style="margin-top:8px"><summary>Environment: Python {{ p.environment.python_version }} on {{ p.environment.os }} ({{ p.environment.dependencies|length }} packages)</summary>
    <p class="mono">{% for k, val in p.environment.dependencies.items() %}{{ k }}=={{ val }}{{ ", " if not loop.last }}{% endfor %}</p>
  </details>
  {% endif %}
</section>

<footer>Generated by Model Passport. Verify with <code>passport verify</code>; this page is a view of the signed passport.json, not a substitute for it.</footer>
</main>
</body>
</html>
